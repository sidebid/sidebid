# Names only. Values live on the host, never in the repo.
PUBLIC_URL=
PORT=8080
# On Railway, leave empty: the volume's mount path is used, and a folder off the volume is refused. Required in production elsewhere.
DATA_DIR=
RPC_URL=
RPC_MAX_RPS=8
# The browser's RPC, written into DATA_DIR/site.json at start. Public safe: a key locked to the domain, never RPC_URL's key.
BROWSER_RPC_URL=
SOLANA_CLUSTER=mainnet-beta
# The program's upgrade authority, shown on the Safety page until it is revoked
UPGRADE_AUTHORITY=
# site.json somewhere else, or the whole file as JSON in a variable. Both optional.
SITE_CONFIG=
SITE_CONFIG_JSON=
WEB_DIST=
PICTURES_DIR=
PROGRAM_ID=5ATUD6arr5QJQtGxH8naPwFcZoDsuosmAVJcsaZ19HDp
ADMIN_SECRET=
# Number of proxies in front of this server, from the deploy test in BACKEND.md. Required in production.
TRUSTED_HOPS=

# Server keys. All three must be different. None of them can move user funds.
LISTING_SECRET=
LISTING_PUBKEY_EXPECTED=
KEEPER_SECRET=
PASS_SECRET=
PASS_HASH_KEY=

# Sign in with X: the app named Sidebid
X_SIGNIN_CLIENT_ID=
X_SIGNIN_CLIENT_SECRET=

# X reading: read only
X_READ_BEARER=
# X posting as the coin's account
X_POST_API_KEY=
X_POST_API_SECRET=
X_POST_TOKEN=
X_POST_TOKEN_SECRET=
X_ACCOUNT_ID=
X_HANDLE=sidebidsol

# X cost control. Prices: X pay per use list, 6 Nov 2026 (BACKEND.md). Every price must be above 0.
# The whole day's X bill. 0 refuses every X call, sign in included. The code ceiling is 25.
X_DAILY_SPEND_CAP_USD=0
# Set aside inside the daily cap for sign ins only, $0.010 each. 0 keeps sign in paused.
X_SIGNIN_CAP_USD=0
# Off: replies carry no link or domain, $0.015 each. 1: the card link, $0.200 each.
X_REPLY_LINKS=0
X_COST_PER_POST_USD=0.015
X_COST_PER_POST_LINK_USD=0.2
X_COST_PER_OWNED_READ_USD=0.001
X_COST_PER_USER_USD=0.01
X_COST_PER_READ_USD=0.005
X_POLL_SECONDS=60
# Reads may use this share of the cap. The rest is kept for replies.
X_READ_SHARE=0.6
# Mention reads per clock hour, in USD. Default: a third of the daily read share.
X_READ_HOURLY_USD=
X_MENTION_PAGE_SIZE=20
X_MENTION_MAX_PAGES=3
# How long to stop calling X after it says the credits ran out
X_CREDITS_PAUSE_MS=3600000

# Tagged card budget
TAG_RENT_BUDGET_LAMPORTS=100000000
TAG_PER_ACCOUNT_DAY=5
TAG_PER_ACCOUNT_OPEN=2
TAG_GLOBAL_PER_HOUR=30
TAG_MIN_LISTING_BALANCE_LAMPORTS=20000000
TAG_DEFAULT_SECONDS=300
TAG_MIN_SECONDS=60
TAG_MAX_SECONDS=3600
TAG_ACCEPT_WINDOW_SECONDS=600
TAG_MENTION_MAX_AGE_MIN=30

# Keeper
KEEPER_TICK_MS=1000
KEEPER_COURTESY_CLOSES_PER_DAY=200
KEEPER_TOKEN_ACCOUNT_DAILY_LAMPORTS=50000000

# Indexer
INDEX_TICK_MS=3000
INDEX_RECONCILE_MS=300000
INDEX_MAX_PAGES=50

# Passes and wallet links
PASS_TTL_SECONDS=120
WALLET_CHANGE_WAIT_HOURS=48

# Brand: every user facing name comes from here
BRAND_NAME=Sidebid
BRAND_TICKER=SIDEBID
BRAND_TAGLINE=

# Hourly creator fee rewards. DEV_SECRET is the coin creator wallet: it only ever claims fees and pays out what it claimed.
DEV_SECRET=
EXPECTED_DEV_PUBKEY=
REWARDS_TEAM_WALLET=
REWARDS_TEAM_BPS=1000
REWARDS_SPLIT_BPS=5000,3000,2000
REWARDS_MIN_CLAIM_SOL=0.002
REWARDS_MIN_PAYOUT_LAMPORTS=1000000
REWARDS_CLOSE_GRACE_S=60
